{
  "name": "nextjs-boilerplate",
  "version": "0.1.0",
  "description": "Next.js boilerplate with husky, lint-staged, eslint + prettier, jest, react-testing-library, storybook, ghaction and plop.",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "prettier:format": "prettier --write .",
    "prettier:check": "prettier --check \"**/*.{ts,tsx,json}\"",
    "lint": "eslint src tests workers",
    "eslint:format": "eslint src --fix",
    "test": "jest",
    "test:rules": "firebase emulators:exec --only firestore \"jest --runInBand tests/firestore.rules.test.ts\"",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --passWithNoTests --testPathIgnorePatterns=tests/firestore.rules.test.ts",
    "postinstall": "husky"
  },
  "engines": {
    "node": ">=18.20.2"
  },
  "packageManager": "pnpm@9.1.1+sha256.9551e803dcb7a1839fdf5416153a844060c7bce013218ce823410532504ac10b",
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@t3-oss/env-nextjs": "0.12.0",
    "@tanstack/react-query": "^5.104.0",
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.542.0",
    "next": "15.5.27",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.0.1",
    "zod": "3.24.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.19.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "babel-jest": "29.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-import-helpers": "2.0.1",
    "eslint-plugin-prettier": "5.2.3",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "0.11.2",
    "eslint-plugin-testing-library": "7.1.1",
    "firebase-tools": "^15.32.1",
    "globals": "^15.14.0",
    "husky": "9.1.7",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-watch-typeahead": "2.2.2",
    "lint-staged": "15.4.3",
    "pinst": "3.0.0",
    "postcss": "8.5.1",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.11",
    "storybook": "^8.5.3",
    "tailwind-scrollbar": "4.0.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "wrangler": "^4.147.0"
  },
  "lint-staged": {
    "src/**/*": [
      "pnpm prettier:format",
      "pnpm eslint:format"
    ]
  },
  "pnpm": {
    "overrides": {
      "@types/react": "npm:types-react@19.0.0-rc.1",
      "@types/react-dom": "npm:types-react-dom@19.0.0-rc.1"
    }
  }
}
